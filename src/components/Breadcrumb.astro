---
import { SITE } from '../config';

interface Crumb {
  label: string;
  href?: string; // 省略则为当前页（不可点击）
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

// 面包屑结构化数据（BreadcrumbList），SEO 核心
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, SITE.url).href } : {}),
  })),
};
---

<nav aria-label="面包屑" class="mb-4">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-400">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true">/</span>}
          {item.href ? (
            <a href={item.href} class="transition-colors hover:text-gray-700">{item.label}</a>
          ) : (
            <span class="text-gray-600" aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
