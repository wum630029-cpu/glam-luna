---
import { SITE, NAV, EDUCATION_CATEGORIES } from '../config';
---

<footer class="mt-16 border-t border-black/5" style="background: #f1efe9;">
  <div class="mx-auto max-w-7xl px-4 py-10">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
      <div class="col-span-2 sm:col-span-1">
        <p class="font-display text-lg font-semibold tracking-[0.14em]" style={`color: #000`}>{SITE.name}</p>
        <p class="mt-2 text-sm text-gray-600">{SITE.description}</p>
      </div>
      <div>
        <p class="text-sm font-semibold text-gray-900">导航</p>
        <ul class="mt-2 space-y-1.5 text-sm text-gray-600">
          {NAV.map((item) => (
            <li><a href={item.href} class="hover:text-black">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold text-gray-900">选购百科</p>
        <ul class="mt-2 space-y-1.5 text-sm text-gray-600">
          {EDUCATION_CATEGORIES.map((c) => (
            <li><a href={`/education/category/${c.slug}/`} class="hover:text-black">{c.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-8 border-t border-black/5 pt-6 text-sm leading-relaxed text-gray-600">
      <p>本站内容仅供 18 岁以上成年人阅读。情趣内衣为成人用品，请理性消费。</p>
      <p class="mt-2">© {new Date().getFullYear()} {SITE.name}. 保留所有权利。</p>
    </div>
  </div>
</footer>
