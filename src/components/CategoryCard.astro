---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  category: { slug: string; name: string; description: string; cover?: ImageMetadata };
}

const { category } = Astro.props;
const hasCover = Boolean(category.cover);
---

<a
  href={`/education/category/${category.slug}/`}
  class="cat-card group relative flex aspect-[16/10] flex-col justify-end overflow-hidden p-6 lg:aspect-[3/4]"
>
  {
    hasCover && category.cover ? (
      <>
        <Image
          src={category.cover}
          alt={category.name}
          widths={[480, 768]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 20vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-black/10"></div>
      </>
    ) : null
  }

  <!-- 底部文案 -->
  <div class="relative z-10">
    <p class={`text-lg font-semibold leading-snug ${hasCover ? 'text-white' : 'text-black'}`}>{category.name}</p>
    <p class={`mt-1.5 text-sm leading-relaxed ${hasCover ? 'text-white/85' : 'text-gray-600'}`}>{category.description}</p>
    <span class={`mt-3 inline-flex items-center gap-1 text-xs tracking-[0.2em] ${hasCover ? 'text-white' : 'text-black'}`}>
      进入
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>

<style>
  /* 暖灰米面板 · 直角；悬停加深一档并放大（无边框） */
  .cat-card {
    background: var(--panel);
    border-radius: 0;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }
  .cat-card:hover {
    background: #e5e1d9;
    transform: scale(1.05);
    z-index: 1;
  }
</style>
