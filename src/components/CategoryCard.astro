---
interface Props {
  category: { slug: string; name: string; description: string };
  index?: number;
}

const { category, index = 0 } = Astro.props;
---

<a
  href={`/education/category/${category.slug}/`}
  class="cat-card group relative flex aspect-[16/10] flex-col justify-between overflow-hidden p-6 lg:aspect-[3/4]"
>
  <!-- 衬线大序号：纯排印装饰 -->
  <span class="font-display text-4xl leading-none tracking-wide" style="color: rgb(0 0 0 / 16%)">
    {String(index + 1).padStart(2, '0')}
  </span>

  <!-- 底部文案 -->
  <div class="relative">
    <p class="text-lg font-semibold leading-snug text-black">{category.name}</p>
    <p class="mt-1.5 text-sm leading-relaxed text-gray-600">{category.description}</p>
    <span class="mt-3 inline-flex items-center gap-1 text-xs tracking-[0.2em] text-black">
      进入
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>

<style>
  /* 暖灰米面板 · 发丝描边 · 直角；悬停加深一档（La Perla 卡片语法） */
  .cat-card {
    background: var(--panel);
    border: 1px solid var(--hairline);
    border-radius: 0;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .cat-card:hover {
    background: #e5e1d9;
    border-color: rgb(0 0 0 / 30%);
  }
</style>
