---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const outfits = await getCollection('outfits');
  return outfits.map((outfit) => ({ params: { slug: outfit.id }, props: { outfit } }));
}

const { outfit } = Astro.props;
const { Content } = await render(outfit);
const { title, description, cover, images, tags, pubDate } = outfit.data;

// 封面 + 多图；封面若已包含在 images 中则去重（按 src 去重）
const allImages = (cover ? [cover, ...images] : images).filter(
  (img, i, arr) => arr.findIndex((x) => x.src === img.src) === i,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  keywords: tags.join(','),
  ...(cover ? { image: new URL(cover.src, SITE.url).href } : {}),
  mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
};
---

<Base
  title={title}
  description={description}
  type="article"
  image={cover?.src}
  canonical={`/outfits/${outfit.id}/`}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-5xl">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
      <!-- 图：右列（移动端横向滑动轮播，桌面端竖排） -->
      <div class="relative lg:order-2">
        <div
          id="outfit-carousel"
          class="no-scrollbar flex snap-x snap-mandatory gap-3 overflow-x-auto lg:flex-col lg:gap-0 lg:space-y-4 lg:overflow-visible"
        >
          {allImages.map((img, i) => (
            <Image src={img} alt={`${title} 图 ${i + 1}`} class="w-full shrink-0 snap-center rounded-xl object-cover" />
          ))}
        </div>

        {
          allImages.length > 1 && (
            <>
              <span
                id="carousel-count"
                class="absolute right-3 top-3 rounded-full bg-black/45 px-2.5 py-1 text-xs font-medium text-white backdrop-blur lg:hidden"
              >
                1/{allImages.length}
              </span>
              <div id="carousel-dots" class="mt-3 flex justify-center gap-1.5 lg:hidden"></div>
            </>
          )
        }
      </div>

      <!-- 文：左列（桌面端文字在左并跟随滚动，移动端在下） -->
      <div class="lg:sticky lg:top-20 lg:order-1">
        <Breadcrumb
          items={[
            { label: '首页', href: '/' },
            { label: '模特穿搭', href: '/outfits/' },
            { label: title },
          ]}
        />
        <h1 class="mt-2 text-2xl font-bold sm:text-3xl">{title}</h1>
        <p class="mt-2 text-sm text-gray-500">{pubDate.toISOString().slice(0, 10)}</p>

        <div class="prose mt-6 max-w-none">
          <Content />
        </div>

        {
          tags.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-2">
              {tags.map((t) => (
                <span class="tag-chip rounded-full px-3 py-1 text-sm">#{t}</span>
              ))}
            </div>
          )
        }

        <!-- 关联单品（商品板块预留，暂不展示） -->
        {
          outfit.data.relatedProducts.length > 0 && (
            <section class="mt-8 rounded-xl bg-white p-4 shadow-sm ring-1 ring-black/5">
              <h2 class="font-semibold">相关单品</h2>
              <p class="mt-1 text-sm text-gray-500">商品板块上线后展示</p>
            </section>
          )
        }
      </div>
    </div>
  </article>
</Base>

<script>
  const carousel = document.getElementById('outfit-carousel');
  if (carousel && carousel.children.length > 1) {
    const slides = Array.from(carousel.children);
    const countEl = document.getElementById('carousel-count');
    const dotsEl = document.getElementById('carousel-dots');
    const total = slides.length;

    const dots = slides.map((slide, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'carousel-dot';
      dot.setAttribute('aria-label', '第 ' + (i + 1) + ' 张');
      dot.addEventListener('click', () =>
        slide.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' }),
      );
      dotsEl.appendChild(dot);
      return dot;
    });

    const setActive = (i) => {
      countEl.textContent = i + 1 + '/' + total;
      dots.forEach((d, j) => d.classList.toggle('active', j === i));
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) setActive(slides.indexOf(e.target));
        });
      },
      { root: carousel, threshold: 0.6 },
    );

    slides.forEach((s) => io.observe(s));
    setActive(0);
  }
</script>
