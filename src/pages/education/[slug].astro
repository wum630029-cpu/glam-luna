---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Toc from '../../components/Toc.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE, categoryName } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('education');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings = [] } = await render(post);
const { title, description, cover, category, pubDate, updatedDate, tags, author, faq = [], tldr } =
  post.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Organization', name: author },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  articleSection: categoryName(category),
  keywords: tags.join(','),
  ...(cover ? { image: new URL(cover.src, SITE.url).href } : {}),
  mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
};

const faqJsonLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map(({ q, a }) => ({
          '@type': 'Question',
          name: q,
          acceptedAnswer: { '@type': 'Answer', text: a },
        })),
      }
    : null;
---

<Base
  title={title}
  description={description}
  type="article"
  image={cover?.src}
  canonical={`/education/${post.id}/`}
  jsonLd={faqJsonLd ? [jsonLd, faqJsonLd] : jsonLd}
>
  <article class="mx-auto max-w-6xl">
    <Breadcrumb
      items={[
        { label: '首页', href: '/' },
        { label: '情趣内衣选购百科', href: '/education/' },
        { label: categoryName(category), href: `/education/category/${category}/` },
        { label: title },
      ]}
    />
    <h1 class="mt-2 max-w-4xl text-2xl font-bold sm:text-3xl">{title}</h1>
    <p class="mt-2 text-sm text-gray-500">
      {author} · {pubDate.toISOString().slice(0, 10)}
    </p>

    {cover && (
      <Image src={cover} alt={title} class="mt-6 aspect-video w-full max-w-4xl rounded-xl object-cover" />
    )}

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem]">
      <!-- 正文 -->
      <div class="min-w-0 max-w-3xl">
        {tldr && (
          <p class="mb-6 border-l-4 pl-4 text-base font-semibold leading-relaxed text-gray-800" style="border-color: var(--brand);">
            {tldr}
          </p>
        )}

        <div class="prose max-w-none">
          <Content />
        </div>

        {
          tags.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-2">
              {tags.map((t) => (
                <span class="tag-chip rounded-full px-3 py-1 text-sm">#{t}</span>
              ))}
            </div>
          )
        }

        {faq.length > 0 && (
          <section class="mt-10 border-t border-gray-100 pt-8">
            <h2 class="text-xl font-bold">常见问题</h2>
            <div class="mt-4 space-y-5">
              {faq.map((item) => (
                <div>
                  <h3 class="font-semibold text-gray-900">{item.q}</h3>
                  <p class="mt-1 text-gray-600">{item.a}</p>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- 右侧目录 -->
      <Toc headings={headings} />
    </div>
  </article>
</Base>
