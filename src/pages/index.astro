---
import Base from '../layouts/Base.astro';
import OutfitCard from '../components/OutfitCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE, EDUCATION_CATEGORIES, categoryName } from '../config';
import heroImg from '../assets/home/hero.png';

const education = await getCollection('education');
const outfits = await getCollection('outfits');
const latestEducation = education
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const latestOutfits = outfits
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: SITE.language,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
];
---

<Base title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative -mt-8 overflow-hidden [margin-left:calc(50%_-_50vw)] [margin-right:calc(50%_-_50vw)]">
    <Image src={heroImg} alt={SITE.name} class="aspect-[16/9] w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-end px-6 py-8 text-center sm:py-12">
      <h1 class="text-2xl font-bold text-white sm:text-4xl">{SITE.name}</h1>
      <p class="mx-auto mt-3 max-w-xl text-sm text-white/90 sm:text-base">{SITE.description}</p>
      <div class="mt-7 flex flex-wrap justify-center gap-4">
        <a href="/education/" class="btn-hero">
          情趣内衣选购百科
        </a>
        <a href="/outfits/" class="btn-hero">
          模特穿搭
        </a>
      </div>
    </div>
  </section>

  <!-- 选购百科分类 -->
  <section class="mt-16">
    <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-gray-400">Education</p>
    <h2 class="mt-1 text-xl font-semibold">选购百科分类</h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {EDUCATION_CATEGORIES.map((c, i) => <CategoryCard category={c} index={i} />)}
    </div>
  </section>

  <!-- 最新选购百科 -->
  <section class="mt-16">
    <div class="flex items-end justify-between">
      <div>
        <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-gray-400">Latest Articles</p>
        <h2 class="mt-1 text-xl font-semibold">最新选购百科</h2>
      </div>
      <a href="/education/" class="border-b border-black pb-0.5 text-xs tracking-wider transition-colors hover:text-gray-500">查看全部</a>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        latestEducation.map((post) => (
          <a
            href={`/education/${post.id}/`}
            class="rounded-xl bg-white p-4 shadow-sm ring-1 ring-black/5 transition hover:shadow-md"
          >
            <p class="text-xs text-gray-400">{categoryName(post.data.category)}</p>
            <h3 class="mt-1 line-clamp-2 font-semibold text-gray-900">{post.data.title}</h3>
            <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-gray-600">{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 最新穿搭 -->
  <section class="mt-16">
    <div class="flex items-end justify-between">
      <div>
        <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-gray-400">Lookbook</p>
        <h2 class="mt-1 text-xl font-semibold">最新穿搭</h2>
      </div>
      <a href="/outfits/" class="border-b border-black pb-0.5 text-xs tracking-wider transition-colors hover:text-gray-500">查看全部</a>
    </div>
    <div class="mt-4 grid grid-cols-2 items-start gap-3 sm:grid-cols-4">
      {latestOutfits.map((o) => <OutfitCard outfit={o} />)}
    </div>
  </section>
</Base>
