---
import Base from '../layouts/Base.astro';
import OutfitCard from '../components/OutfitCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE, EDUCATION_CATEGORIES, categoryName } from '../config';
import heroImg from '../assets/home/hero.png';

const education = await getCollection('education');
const outfits = await getCollection('outfits');
const latestEducation = education
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const latestOutfits = outfits
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: SITE.nameEn,
    url: SITE.url,
    description: SITE.description,
    inLanguage: SITE.language,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    alternateName: SITE.nameEn,
    url: SITE.url,
  },
];
---

<Base title={`${SITE.name} ${SITE.nameEn}`} description={SITE.description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative -mt-8 overflow-hidden [margin-left:calc(50%_-_50vw)] [margin-right:calc(50%_-_50vw)]">
    <Image src={heroImg} alt={SITE.name} class="aspect-[16/9] w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent"></div>
    <!-- 视频播放按钮 -->
    <button
      id="hero-video-btn"
      type="button"
      aria-label="播放视频"
      class="group absolute top-1/2 left-1/2 z-10 flex size-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/25 backdrop-blur-sm ring-1 ring-white/60 transition hover:scale-110 hover:bg-white/35 sm:size-20"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 size-7 text-white sm:size-9" aria-hidden="true">
        <path d="M8 5.14v13.72c0 .8.87 1.3 1.56.9l11-6.86a1.05 1.05 0 0 0 0-1.8l-11-6.86c-.69-.4-1.56.1-1.56.9Z"></path>
      </svg>
    </button>
    <div class="absolute inset-0 flex flex-col items-center justify-end px-6 pb-16 pt-8 text-center sm:pb-24">
      <h1 class="text-2xl font-bold text-white sm:text-4xl">{SITE.name} {SITE.nameEn}</h1>
      <p class="mx-auto mt-3 max-w-xl text-sm text-white/90 sm:text-base">{SITE.tagline}</p>
      <div class="mt-7 flex flex-wrap justify-center gap-4">
        <a href="/education/" class="btn-hero">
          情趣内衣选购百科
        </a>
        <a href="/outfits/" class="btn-hero">
          模特穿搭
        </a>
      </div>
    </div>
    <!-- 底部波浪分割线：hero 曲线过渡到页面底色 -->
    <svg
      class="absolute bottom-0 left-0 h-8 w-full sm:h-14"
      viewBox="0 0 1440 72"
      preserveAspectRatio="none"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M0,34 C160,66 400,10 720,26 C1040,42 1270,14 1440,38 L1440,72 L0,72 Z"
        fill="#f8f7f5"
      ></path>
    </svg>
  </section>

  <!-- 视频弹窗 -->
  <div
    id="hero-video-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="视频播放"
  >
    <button
      id="hero-video-close"
      type="button"
      aria-label="关闭视频"
      class="absolute top-4 right-4 flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-6" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    <video
      id="hero-video"
      src="/videos/hero.mp4"
      class="max-h-[85vh] w-full max-w-4xl rounded-lg shadow-2xl"
      controls
      playsinline
      preload="none"
    ></video>
  </div>

  <script>
    const btn = document.getElementById('hero-video-btn');
    const modal = document.getElementById('hero-video-modal');
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    const closeBtn = document.getElementById('hero-video-close');

    function closeModal() {
      if (!modal || !video) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      video.pause();
    }

    // 若仍处于全屏状态则退出，回到页面（hero）
    function exitFullscreen() {
      const d = document as Document & { webkitExitFullscreen?: () => void };
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      else if (d.webkitExitFullscreen) d.webkitExitFullscreen();
    }

    // 在用户点击手势内同步发起全屏请求
    async function enterFullscreen(v: HTMLVideoElement) {
      const w = v as HTMLVideoElement & {
        webkitRequestFullscreen?: () => Promise<void> | void;
        webkitEnterFullscreen?: () => void;
      };
      try {
        if (v.requestFullscreen) await v.requestFullscreen();
        else if (w.webkitRequestFullscreen) await w.webkitRequestFullscreen();
        else if (w.webkitEnterFullscreen) w.webkitEnterFullscreen(); // iOS iPhone 原生播放器
      } catch {
        /* 全屏失败时停留在弹窗模式 */
      }
    }

    btn?.addEventListener('click', () => {
      if (!modal || !video) return;
      // 弹窗仅作为全屏失败时的兜底界面
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      enterFullscreen(video);
      video.play().catch(() => {});
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
    });
    // 退出全屏 / iOS 原生播放器关闭 / 视频播完 → 自动退回 hero
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) closeModal();
    });
    video?.addEventListener('webkitendfullscreen', closeModal);
    video?.addEventListener('ended', () => {
      exitFullscreen();
      closeModal();
    });
  </script>

  <!-- 选购百科分类 -->
  <section class="mt-16">
    <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-gray-400">Education</p>
    <h2 class="mt-1 text-xl font-semibold">选购百科分类</h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {EDUCATION_CATEGORIES.map((c) => <CategoryCard category={c} />)}
    </div>
  </section>

  <!-- 最新选购百科 -->
  <section class="mt-16">
    <div class="flex items-end justify-between">
      <div>
        <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-gray-400">Latest Articles</p>
        <h2 class="mt-1 text-xl font-semibold">最新选购百科</h2>
      </div>
      <a href="/education/" class="border-b border-black pb-0.5 text-xs tracking-wider transition-colors hover:text-gray-500">查看全部</a>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        latestEducation.map((post) => (
          <a
            href={`/education/${post.id}/`}
            class="rounded-xl bg-white p-4 shadow-sm ring-1 ring-black/5 transition hover:shadow-md"
          >
            <p class="text-xs text-gray-400">{categoryName(post.data.category)}</p>
            <h3 class="mt-1 line-clamp-2 font-semibold text-gray-900">{post.data.title}</h3>
            <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-gray-600">{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 最新穿搭 -->
  <section class="mt-16">
    <div class="flex items-end justify-between">
      <div>
        <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-gray-400">Lookbook</p>
        <h2 class="mt-1 text-xl font-semibold">最新穿搭</h2>
      </div>
      <a href="/outfits/" class="border-b border-black pb-0.5 text-xs tracking-wider transition-colors hover:text-gray-500">查看全部</a>
    </div>
    <div class="mt-4 grid grid-cols-2 items-start gap-3 sm:grid-cols-4">
      {latestOutfits.map((o) => <OutfitCard outfit={o} />)}
    </div>
  </section>
</Base>
